{
  "family": "shopsmart-frontend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::065624034072:role/LabRole",
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "shopsmart-frontend-container",
      "image": "shopsmart-frontend",
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "NEXT_PUBLIC_API_URL", "value": "http://localhost:4000/api" }
      ]
    }
  ]
}
