{
  "family": "shopsmart-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::065624034072:role/LabRole",
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "shopsmart-backend-container",
      "image": "shopsmart-backend",
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 4000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "PORT", "value": "4000" },
        { "name": "CLIENT_URL", "value": "http://localhost:3000" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "DATABASE_URL", "value": "postgresql://neondb_owner:npg_QYjT8IBzgh7W@ep-icy-hall-ad4y9imn-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require" }
      ]
    }
  ]
}
